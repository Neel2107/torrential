#!/bin/sh
# Rejects a commit whose subject is longer than 72 characters. Merge commits pass. Enable with
# `git config core.hooksPath mobile/scripts/hooks`; `git commit --no-verify` skips it.
set -eu

limit=72
subject=$(grep -v '^#' "$1" | sed '/^[[:space:]]*$/d' | head -1)
case $subject in
  Merge\ *) exit 0 ;;
esac

length=$(printf '%s' "$subject" | LC_ALL=C tr -d '\200-\277' | wc -c | tr -d ' ')
if [ "$length" -gt "$limit" ]; then
  echo "commit-msg: the subject is $length characters; keep it to $limit and put the rest in the body:" >&2
  echo "  $subject" >&2
  echo "Your message is in $(git rev-parse --git-dir)/COMMIT_EDITMSG." >&2
  exit 1
fi
